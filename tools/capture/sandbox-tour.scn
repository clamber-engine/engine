# clamber-scenario v1
#
# The README's gameplay capture (tools/capture.sh): from the title
# screen, hop up two one-way platforms, drop off, then run right with
# jumps over the hill to the foot of the shaft, and pause.
id: sandbox-tour
summary: A short tour of the sandbox level for the README's GIF
requires: content/levels/sandbox.level
start: the title screen, before the level starts
frames: 690

[inputs]
40-40 J        # Start
41-641 R
101-116 J
173-188 J
221-641 A
291-306 J
371-386 J
441-456 J
511-526 J
561-576 J
670-670 P      # pause at the end
