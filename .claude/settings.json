{
  "permissions": {
    "deny": [
      "WebSearch",
      "Read(**/*.sfc)",
      "Read(**/*.smc)",
      "Read(**/*.swc)",
      "Read(**/*.fig)",
      "Read(**/*.spc)",
      "Edit(.claude/**)",
      "Edit(ci/**)",
      "Edit(.github/**)",
      "Edit(CONTRIBUTING.md)",
      "Edit(CLAUDE.md)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(gh repo delete*)"
    ],
    "additionalDirectories": [
      "~/.cargo",
      "~/.rustup"
    ],
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(cargo *)",
      "Bash(ci/forbid-roms.sh)",
      "Bash(ci/taint-lint.sh)"
    ]
  },
  "disableClaudeAiConnectors": true,
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "index.crates.io",
        "static.crates.io",
        "crates.io",
        "static.rust-lang.org",
        "docs.rs",
        "doc.rust-lang.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cargo",
        "~/.rustup"
      ]
    },
    "excludedCommands": [
      "git *",
      "gh *"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebSearch|WebFetch|Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/taint-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
