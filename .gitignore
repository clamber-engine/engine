/target
__pycache__/
**/*.rs.bk

# Never commit ROM images or rips, even by accident.
*.sfc
*.smc
*.swc
*.fig
*.spc

# Converted content from a user's own ROM stays local.
/content/imported/

# Local Claude Code state
.claude/settings.local.json
.claude/taint-guard.log

# The sandbox mounts these at the repo root; they aren't project files.
/.bash_profile
/.bashrc
/.gitconfig
/.idea
/.mcp.json
/.profile
/.ripgreprc
/.vscode
/.zprofile
/.zshrc
