# clamber level v1
#
# For scenario slope-dip. The scenario gives the floor height of every
# 1 px column from column 0, the one holding the start, whose left edge
# is at x 64; the start is 0.26953125 px past it. Columns 0 to 421 are
# flat, 422 to 481 step down 1 px every 4 columns to 15 px, 482 to 513
# are flat at 16 px, 514 to 573 step back up the same way, and from 574
# the floor is flat again at the starting height.
format = 1
name = "Test: walk down and up 1-in-4 slopes"
size = [1024, 480]
start = [64.26953125, 400]

[[collision]]
shape = "polygon"
points = [[0, 400], [486, 400], [486, 401], [490, 401], [490, 402], [494, 402], [494, 403], [498, 403], [498, 404], [502, 404], [502, 405], [506, 405], [506, 406], [510, 406], [510, 407], [514, 407], [514, 408], [518, 408], [518, 409], [522, 409], [522, 410], [526, 410], [526, 411], [530, 411], [530, 412], [534, 412], [534, 413], [538, 413], [538, 414], [542, 414], [542, 415], [546, 415], [546, 416], [578, 416], [578, 415], [582, 415], [582, 414], [586, 414], [586, 413], [590, 413], [590, 412], [594, 412], [594, 411], [598, 411], [598, 410], [602, 410], [602, 409], [606, 409], [606, 408], [610, 408], [610, 407], [614, 407], [614, 406], [618, 406], [618, 405], [622, 405], [622, 404], [626, 404], [626, 403], [630, 403], [630, 402], [634, 402], [634, 401], [638, 401], [638, 400], [1024, 400], [1024, 480], [0, 480]]
