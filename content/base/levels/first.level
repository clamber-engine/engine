# clamber level v1
#
# The first level: the jungle floor, with steps, slopes, pits and a
# bunch hidden under a drop; a climb into the treetops and a rope
# across the canopy; a cave with a restart barrel at its mouth and a
# spring up out of it; then hills, a slope to roll down through
# crawlers, a tower, launchers, and the goal.
#
# Made by tools/levels/first.py, which lays out the collision and the
# terrain tiles together, and places the props along them. Edit that
# and run it again instead of editing this file.
format = 1
name = "First Steps"
size = [13984, 960]
start = [104, 736]

[camera]
look_ahead = [32, 24]

[music]
file = "../music/grasslands-theme.mp3"

[[lights]]
at = [5176, 512]
color = "#ffb060"
radius = 96

[[lights]]
at = [5816, 592]
color = "#70e0ff"
radius = 64

[[lights]]
at = [6248, 560]
color = "#ffb060"
radius = 96

[[lights]]
at = [6376, 544]
color = "#b080ff"
radius = 64

[[lights]]
at = [6664, 560]
color = "#ffb060"
radius = 96

