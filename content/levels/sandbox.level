# clamber level v1
#
# A playground for trying movement and the camera: flat ground, one-way
# platforms, a hill with a gentle and a steep side, a climb up a shaft
# where the camera holds still horizontally, and past the shaft, a
# launcher and two enemies to try. Platforms are 56 px apart, within the
# default preset's 72 px jump.
format = 1
name = "Sandbox"
size = [3000, 1200]
start = [120, 1000]

[camera]
look_ahead = [32, 24]

[music]
file = "../base/music/theme.wav"

# The placeholder backgrounds, scrolling sideways only.
[[layers]]
name = "sky"
image = "../base/backgrounds/sky.png"
parallax = [0.05, 0]
repeat = [true, false]

[[layers]]
name = "mountains"
image = "../base/backgrounds/mountains.png"
parallax = [0.2, 0]
offset = [0, 56]
repeat = [true, false]

[[layers]]
name = "hills"
image = "../base/backgrounds/hills.png"
parallax = [0.4, 0]
offset = [0, 96]
repeat = [true, false]

# Walls at both ends.
[[collision]]
shape = "rect"
rect = [0, 0, 32, 1000]

[[collision]]
shape = "rect"
rect = [2968, 0, 32, 1000]

# Ground, then a hill: a gentle slope up, a plateau, a steep side down.
[[collision]]
shape = "rect"
rect = [0, 1000, 1200, 200]

[[collision]]
shape = "polygon"
points = [[1200, 1000], [1456, 872], [1800, 872], [1928, 1000],
          [3000, 1000], [3000, 1200], [1200, 1200]]

# Steps of one-way platforms.

[[collision]]
shape = "segment"
from = [320, 944]
to = [440, 944]
one_way = true

[[collision]]
shape = "segment"
from = [500, 888]
to = [620, 888]
one_way = true

[[collision]]
shape = "segment"
from = [320, 832]
to = [440, 832]
one_way = true

[[collision]]
shape = "segment"
from = [500, 776]
to = [620, 776]
one_way = true

# The shaft: the camera stays centred on it and follows the climb.
[[regions]]
name = "shaft"
rect = [2400, 0, 300, 1000]
camera = { lock_x = 2550 }

[[collision]]
shape = "segment"
from = [2410, 944]
to = [2530, 944]
one_way = true

[[collision]]
shape = "segment"
from = [2570, 888]
to = [2690, 888]
one_way = true

[[collision]]
shape = "segment"
from = [2410, 832]
to = [2530, 832]
one_way = true

[[collision]]
shape = "segment"
from = [2570, 776]
to = [2690, 776]
one_way = true

[[collision]]
shape = "segment"
from = [2410, 720]
to = [2530, 720]
one_way = true

[[collision]]
shape = "segment"
from = [2570, 664]
to = [2690, 664]
one_way = true

[[collision]]
shape = "segment"
from = [2410, 608]
to = [2530, 608]
one_way = true

[[collision]]
shape = "segment"
from = [2570, 552]
to = [2690, 552]
one_way = true

[[collision]]
shape = "segment"
from = [2410, 496]
to = [2530, 496]
one_way = true

[[collision]]
shape = "segment"
from = [2570, 440]
to = [2690, 440]
one_way = true

# Past the shaft: a launcher on the ground, a crawler pacing a block, and
# a flutter rising and falling above it.
[[entities]]
type = "launcher"
at = [2740, 992]

[[collision]]
shape = "rect"
rect = [2800, 960, 140, 40]

[[entities]]
type = "crawler"
at = [2870, 960]

[[entities]]
type = "flutter"
at = [2870, 900]
params = { path = [0, -64] }
